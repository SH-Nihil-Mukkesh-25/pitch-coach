# Pitch Coach Backend Environment Configuration
# Copy this file to .env and fill in the required values. Never commit .env.

# ── Groq: audio-analysis pipeline (Whisper STT + agentic coach) ──────────────
# Use a dedicated key (console.groq.com → API Keys) so this feature has its own quota.
GROQ_AUDIO_API_KEY=your_dedicated_groq_key_here
# Optional fallback if GROQ_AUDIO_API_KEY is empty:
GROQ_API_KEY=
# Optional model overrides (defaults shown):
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_TEXT_MODEL=openai/gpt-oss-120b

# ── Slide Coach Storage & TTL ────────────────────────────────────────────────
# Local directory for rendered slide JPEGs (backed by Firestore documents)
SLIDE_DECK_DIR=./slide_decks
# Auto-cleanup period in days for confidential pitch decks
SLIDE_DECK_TTL_DAYS=7

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ── Security & Access Control ────────────────────────────────────────────────
# Comma-separated allowed CORS origins (leave empty to deny all cross-origin browser requests):
# Example: https://app.pitchcoach.com,http://localhost:3000
ALLOWED_ORIGINS=

# Comma-separated admin user IDs allowed to run administrative endpoints (e.g. POST /slides/cleanup)
# Example: usr_admin1,usr_admin2
ADMIN_USER_IDS=

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Path to your Firebase Admin SDK service-account JSON.
# Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_service_account.json

# ── Audio storage (Firebase Storage) ─────────────────────────────────────────
# Bucket name from Firebase Console → Storage (no gs:// prefix).
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
MAX_AUDIO_UPLOAD_MB=25

# ── Cloudflare D1 ─────────────────────────────────────────────────────────────
# Cloudflare Account ID (Dashboard → Overview → Account ID)
CF_ACCOUNT_ID=
# Cloudflare D1 Database ID (created via: wrangler d1 create pitch-coach-db)
CF_D1_DATABASE_ID=
# Cloudflare API Token with D1 edit permissions (Dashboard → API Tokens → Create Token)
CF_API_TOKEN=

# ── MongoDB (Document database: users, sessions, slide_decks, achievements, quotas) ─
# Local MongoDB: mongodb://localhost:27017 or Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pitch_coach
